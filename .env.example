# 复制为 .env 并填入真实值。.env 不会进版本库。

# ---- LLM（可选增强：理由生成。不填或不通时自动降级为规则模板）----
# provider=anthropic 走 /v1/messages；provider=openai 走 /v1/chat/completions(DeepSeek/MiMo 等)
LLM_ENABLED=true
LLM_PROVIDER=anthropic
LLM_BASE_URL=https://your-relay-or-api-host
LLM_API_KEY=your-key-here
LLM_MODEL=claude-opus-4-8
LLM_ANTHROPIC_BETA=
LLM_TIMEOUT=45
# 示例：改用 DeepSeek(OpenAI 兼容)
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://api.deepseek.com
#   LLM_MODEL=deepseek-chat
#   LLM_API_KEY=sk-你的deepseek key

# ---- 数据库 ----
DATABASE_URL=sqlite:///data/wc2026.db

# ---- 数据源 ----
INTL_RESULTS_BASE=https://raw.githubusercontent.com/martj42/international_results/master

# ---- 赔率源（The Odds API，免费 tier 约 500 次/月，注册 the-odds-api.com 获取）----
ODDS_API_KEY=your-odds-api-key

# ---- 访问控制（可选）----
# 留空：不限制，打开即全功能（本机/单人）。
# 设为随机串后：只有用 URL  .../?owner=<该值>  访问才是“所有者”(可拉取/训练/AI)；
# 其他人用普通网址=只读访客，拉取/训练/AI 按钮被锁定（不消耗 API 配额与 LLM token）。
OWNER_KEY=

# 站点访问口令：留空=任何人打开网址即可查看。
# 设为你的口令后：普通网址访问需先输入该口令才能查看（用于挡住陌生 IP/访问）；
# 管理员仍用 URL  .../?owner=<OWNER_KEY>  进入，免口令（老方式不变）。
# 重要：要让“访客需口令、管理员走参数”同时生效，请同时设置 OWNER_KEY 与 ACCESS_PASSWORD。
ACCESS_PASSWORD=
